<Window x:Class="ByteFlow.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ByteFlow" Icon="Assets/byteflow-v2.ico" Title="ByteFlow · 应用网络控制" Width="1380" Height="820" MinWidth="1120" MinHeight="620" Background="#0E151F" Foreground="#EDF3FF">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Padding" Value="14,9"/><Setter Property="Margin" Value="4"/><Setter Property="Background" Value="#23354B"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/></Style>
  <Style x:Key="NetworkSwitch" TargetType="ToggleButton">
   <Setter Property="Focusable" Value="False"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Grid Width="42" Height="24"><Border x:Name="Track" Background="#54647A" CornerRadius="12"/><Ellipse x:Name="Thumb" Fill="White" Width="18" Height="18" HorizontalAlignment="Left" Margin="3"/></Grid><TextBlock x:Name="Label" Text="{DynamicResource 已禁止}" Margin="8,0" Foreground="#A4B2C5"/></StackPanel><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="#0BAA83"/><Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/><Setter TargetName="Label" Property="Text" Value="{DynamicResource 允许联网}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Grid x:Name="RootLayout" Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel x:Name="FullToolbar" Margin="0,0,0,18"><Button DockPanel.Dock="Right" Content="{DynamicResource 精简模式}" Click="ToggleCompact"/><Image Source="Assets/byteflow-v2.png" Width="36" Height="36" Margin="0,0,10,0"/><TextBlock Text="ByteFlow" FontSize="26" FontWeight="Bold" Margin="0,0,24,0"/><ToggleButton DockPanel.Dock="Right" IsChecked="{Binding Topmost, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}" ToolTip="{DynamicResource 点击切换窗口置顶}" Margin="4" Padding="16,9" FontWeight="SemiBold" Cursor="Hand"><ToggleButton.Style><Style TargetType="ToggleButton"><Setter Property="Content" Value="{DynamicResource 窗口置顶}"/><Setter Property="Foreground" Value="#8FEED4"/><Setter Property="Background" Value="#193C40"/><Setter Property="BorderBrush" Value="#27BF9E"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter><Style.Triggers><Trigger Property="IsChecked" Value="True"><Setter Property="Content" Value="{DynamicResource 已置顶}"/><Setter Property="Background" Value="#16B58C"/><Setter Property="Foreground" Value="#081D20"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="#C0FFED"/></Trigger></Style.Triggers></Style></ToggleButton.Style></ToggleButton><Button DockPanel.Dock="Right" Content="{DynamicResource 设置}" Click="OpenSettings"/><Button DockPanel.Dock="Right" Content="{DynamicResource 统计数据}" Click="OpenUsage"/><CheckBox x:Name="ShowSystem" DockPanel.Dock="Right" Content="{DynamicResource 显示系统进程}" Foreground="#93A9C5" VerticalAlignment="Center" Margin="12,0" Checked="SystemFilterChanged" Unchecked="SystemFilterChanged"/><Button DockPanel.Dock="Right" Content="{DynamicResource 恢复全部联网}" Click="RestoreAll"/><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="20,0"><TextBlock x:Name="Download" Foreground="#34D7AC" Margin="0,0,20,0"/><TextBlock x:Name="Upload" Foreground="#66A8FF"/></StackPanel><Border/></DockPanel>
  <DockPanel x:Name="CompactToolbar" Visibility="Collapsed" Margin="0,0,0,4"><Button DockPanel.Dock="Right" Content="↗" ToolTip="{DynamicResource 完整模式}" Click="ToggleCompact" Padding="7,2" Margin="2"/><ToggleButton DockPanel.Dock="Right" Content="◆" ToolTip="{DynamicResource 窗口置顶}" IsChecked="{Binding Topmost, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}" Padding="7,2" Margin="2"/><ToggleButton DockPanel.Dock="Right" Content="★" ToolTip="{DynamicResource 只看关注}" IsChecked="{Binding IsChecked, ElementName=OnlyFavorites, Mode=TwoWay}" Padding="7,2" Margin="2"/><TextBlock x:Name="CompactRates" Foreground="#69E4BE" FontSize="11"/></DockPanel><StackPanel x:Name="FullFilters" Grid.Row="1"><WrapPanel Margin="0,0,0,10"><CheckBox x:Name="OnlyFavorites" Content="{DynamicResource 只看关注}" Foreground="#93A9C5" VerticalAlignment="Center" Margin="0,0,16,0" Checked="ViewOptionsChanged" Unchecked="ViewOptionsChanged"/><Button Content="{DynamicResource 恢复隐藏应用}" Click="RestoreHidden"/><CheckBox x:Name="ShowDetails" Content="{DynamicResource 显示详情}" Foreground="#93A9C5" VerticalAlignment="Center" Margin="16,0" IsChecked="True" Checked="ViewOptionsChanged" Unchecked="ViewOptionsChanged"/><TextBlock Text="{DynamicResource 右键应用可关注或隐藏}" Foreground="#93A9C5" Margin="16,0"/></WrapPanel><TextBlock x:Name="RateHint" Text="{DynamicResource 正在启动实时速率采集…}" Foreground="#93A9C5" Margin="0,0,0,12"/></StackPanel><Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="DetailGap" Width="16"/><ColumnDefinition x:Name="DetailColumn" Width="310"/></Grid.ColumnDefinitions>
   <DataGrid x:Name="Table" EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" RowHeight="48" Background="#141E2B" Foreground="#E3ECFA" BorderThickness="0" GridLinesVisibility="None" AlternatingRowBackground="#192637" RowBackground="#141E2B" SelectionMode="Single" SelectionUnit="FullRow" SelectionChanged="SelectionChanged" Sorting="SortApplications">
    <DataGrid.RowStyle><Style TargetType="DataGridRow"><Setter Property="ContextMenu"><Setter.Value><ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"><MenuItem Header="{DynamicResource 关注或取消关注}" ><MenuItem.Style><Style TargetType="MenuItem"><EventSetter Event="Click" Handler="ToggleFavorite"/></Style></MenuItem.Style></MenuItem><MenuItem Header="{DynamicResource 隐藏此应用}" ><MenuItem.Style><Style TargetType="MenuItem"><EventSetter Event="Click" Handler="HideApp"/></Style></MenuItem.Style></MenuItem></ContextMenu></Setter.Value></Setter><Style.Triggers><DataTrigger Binding="{Binding IsFavorite}" Value="True"><Setter Property="Background" Value="#293246"/><Setter Property="Foreground" Value="#FFD782"/></DataTrigger></Style.Triggers></Style></DataGrid.RowStyle><DataGrid.Resources>
     <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#1D2B3E"/><Setter Property="Foreground" Value="#B6C8E2"/><Setter Property="Padding" Value="10"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
     <Style TargetType="DataGridCell">
      <Setter Property="Padding" Value="10,0"/><Setter Property="BorderThickness" Value="0"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="{TemplateBinding VerticalContentAlignment}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" SnapsToDevicePixels="True"/></Border></ControlTemplate></Setter.Value></Setter>
     </Style>
     <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="TextWrapping" Value="NoWrap"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/></Style>
    </DataGrid.Resources>
    <DataGrid.Columns><DataGridTextColumn Header="{DynamicResource 应用}" SortMemberPath="Name" Binding="{Binding DisplayName}" Width="*" MinWidth="130"/><DataGridTextColumn Header="{DynamicResource 进程数}" SortMemberPath="ProcessCount" Binding="{Binding ProcessCount}" Width="65"/><DataGridTextColumn Header="{DynamicResource ↓ 下载速率}" SortMemberPath="Down" Binding="{Binding DownText}" Width="110"/><DataGridTextColumn Header="{DynamicResource ↑ 上传速率}" SortMemberPath="Up" Binding="{Binding UpText}" Width="110"/><DataGridTextColumn Header="{DynamicResource 累计流量}" SortMemberPath="Bytes" Binding="{Binding TotalText}" Width="110"/><DataGridTemplateColumn Header="{DynamicResource 联网开关}" Width="145"><DataGridTemplateColumn.CellTemplate><DataTemplate><ToggleButton Style="{StaticResource NetworkSwitch}" IsChecked="{Binding Allowed, Mode=OneWay}" IsEnabled="{Binding CanControl}" Click="Toggle" ToolTip="{DynamicResource 开：允许联网；关：阻止该程序联网}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns>
   </DataGrid>
   <Border x:Name="DetailPanel" Grid.Column="2" Background="#141E2B" Padding="22" CornerRadius="10"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
    <DockPanel Margin="0,0,0,20"><Button Content="×" DockPanel.Dock="Right" Click="CloseDetails" Padding="8,2"/><TextBlock Text="{DynamicResource 应用详情}" Foreground="#839BB9"/></DockPanel>
    <TextBlock x:Name="DetailName" Text="{DynamicResource 选择一个应用}" FontSize="23" FontWeight="Bold" TextWrapping="Wrap"/>
    <TextBlock x:Name="DetailPath" Foreground="#93A9C5" TextWrapping="Wrap" Margin="0,12,0,20"/>
    <ToggleButton x:Name="DetailSwitch" Style="{StaticResource NetworkSwitch}" Click="Toggle" IsEnabled="False" Margin="0,0,0,24"/>
    <TextBlock Text="{DynamicResource 实时速度}" Foreground="#609FFF" FontWeight="Bold"/>
    <TextBlock x:Name="DetailRates" FontSize="19" Margin="0,12,0,24" TextWrapping="Wrap"/>
    <TextBlock Text="{DynamicResource 本次监控累计}" Foreground="#609FFF" FontWeight="Bold"/>
    <TextBlock x:Name="DetailTotal" FontSize="24" Margin="0,12,0,24"/>
    <TextBlock Text="{DynamicResource 速度走势}" Foreground="#609FFF" FontWeight="Bold"/><ComboBox x:Name="ChartRange" SelectedIndex="1" SelectionChanged="ChartRangeChanged" Margin="0,10,0,4"><ComboBoxItem Content="{DynamicResource 最近一分钟}"/><ComboBoxItem Content="{DynamicResource 最近五分钟}"/><ComboBoxItem Content="{DynamicResource 本次全部}"/></ComboBox><local:SpeedChart x:Name="HistoryChart" Height="180" Margin="0,0,0,16"/><TextBlock Text="{DynamicResource 控制范围}" Foreground="#609FFF" FontWeight="Bold"/>
    <TextBlock Text="{DynamicResource 开关按程序路径生效，同一应用的所有进程统一控制。关闭开关后，Windows 防火墙将阻止该程序收发网络数据。}" TextWrapping="Wrap" Foreground="#93A9C5" Margin="0,12,0,18"/>
    <TextBlock Text="{DynamicResource 退出 ByteFlow 后，断网规则仍保留。重新打开即可恢复联网。}" TextWrapping="Wrap" Foreground="#E6BC78"/>
   </StackPanel></ScrollViewer></Border>
  </Grid>
  <DockPanel x:Name="FullStatus" Grid.Row="3" Margin="0,16,0,0"><TextBlock x:Name="Total" DockPanel.Dock="Right" Foreground="#93A9C5"/><TextBlock x:Name="Status" Text="{DynamicResource 正在启动网络监控…}" Foreground="#34D7AC" TextWrapping="Wrap"/></DockPanel>
 </Grid>
</Window>







